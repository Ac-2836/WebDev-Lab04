# Copy to .env and adjust. Never commit .env.

# Express API (server/index.js)
PORT=3001
CLIENT_ORIGIN=http://localhost:5173

# Vite client (exposed to the browser, no secrets here)
VITE_API_URL=http://localhost:3001

# MongoDB for HW 2 and HW 3 (local Docker: docker run -d --name lab4-mongo -p 27017:27017 mongo:8)
MONGODB_URI=mongodb://localhost:27017/lab4
